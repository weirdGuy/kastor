# Built binary
/kastor

# Test/coverage artifacts
*.out

# Generated output: reproducible from `kastor build`, deliberately not
# committed — codegen determinism is enforced by tests, so committed
# artifacts are not needed to detect drift.
examples/**/gen/

# Plan/apply state: maps block addresses to remote resource ids —
# environment-specific like tfstate, never committed. The lock file is
# transient by design. (State-package test fixtures live in tracked
# testdata directories and are unaffected by these example-scoped rules.)
examples/**/kastor.state.json
examples/**/.kastor.state.lock

# MCP server connection config. `kastor build` generates it from the
# module's mcp_server blocks, so a copy in a source tree is build output —
# and a hosted endpoint's url can carry an API key as a query param, which
# must never become committable by accident. Codegen goldens are the one
# exception: they are the assertion about what the generator emits, so they
# have to be tracked.
mcp_servers.json
!internal/build/**/testdata/**/mcp_servers.json

# Python artifacts from running generated projects
**/__pycache__/
**/.venv/

# GoReleaser output
dist/

# system stuff
.DS_Store