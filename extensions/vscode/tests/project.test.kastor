# SYNTAX TEST "source.kastor" "project files"

model "fast" {
# <- entity.name.type.kastor
#^^^^ entity.name.type.kastor
#      ^^^^ variable.other.enummember.kastor
  provider = "openai"
# ^^^^^^^^ variable.other.readwrite.kastor
#             ^^^^^^ string.quoted.double.kastor
  params {
# ^^^^^^ entity.name.type.kastor
    temperature = 0.2
#   ^^^^^^^^^^^ variable.other.readwrite.kastor
#                 ^^^ constant.numeric.float.kastor
    max_tokens  = 4096
#                 ^^^^ constant.numeric.integer.kastor
target "langgraph" {
# <- entity.name.type.kastor
#^^^^^ entity.name.type.kastor
#       ^^^^^^^^^ variable.other.enummember.kastor
  type   = "codegen"
#           ^^^^^^^ support.constant.kastor
  output = "./gen/langgraph"
# ^^^^^^ variable.other.readwrite.kastor
#           ^^^^^^^^^^^^^^^ string.quoted.double.kastor
  auth {
# ^^^^ entity.name.type.kastor
    api_key_env = "ANTHROPIC_API_KEY"
#   ^^^^^^^^^^^ variable.other.readwrite.kastor
mcp_server "hubspot" {
# <- entity.name.type.kastor
#^^^^^^^^^ entity.name.type.kastor
#           ^^^^^^^ variable.other.enummember.kastor
  transport = "http"
#              ^^^^ support.constant.kastor
  url       = "https://mcp.hubspot.com"
# ^^^ variable.other.readwrite.kastor
  auth {
# ^^^^ entity.name.type.kastor
    ref     = "connection://cred_011CZkZDLs7fYzm1hXNPeRjv"
#   ^^^ variable.other.readwrite.kastor
#              ^^^^^^^^^^ support.constant.kastor
#                        ^^^ keyword.operator.accessor.kastor
    targets = [target.langgraph]
#              ^^^^^^ support.class.kastor
#                    ^ keyword.operator.accessor.kastor
#                     ^^^^^^^^^ variable.other.member.kastor
